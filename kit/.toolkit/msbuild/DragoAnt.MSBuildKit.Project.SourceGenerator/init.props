<Project>

  <!-- Opt-in: the authoring project imports $(SourceGeneratorCommonPropsPath) itself; importing it here would
       turn every project into a Roslyn component. -->
  <PropertyGroup>
    <SourceGeneratorCommonPropsPath>$(MSBuildThisFileDirectory)source.generator.props</SourceGeneratorCommonPropsPath>
    <MSKit_SourceGeneratorSatelliteAttached>true</MSKit_SourceGeneratorSatelliteAttached>
  </PropertyGroup>

</Project>
