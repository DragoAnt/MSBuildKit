<Project>

  <Import Project="$(MSBuildThisFileDirectory)implicit.package.targets" />

  <ImportGroup Condition="('$(IsTestsProject)'=='True' Or '$(IsTestsLibProject)'=='True') AND '$(MSKit_TestingFramework)'=='xunit.v3'">
    <Import Project="$(MSBuildThisFileDirectory)tests.project.xunit.v3.routine.targets" />
  </ImportGroup>

</Project>
